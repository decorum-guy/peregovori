{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Peregovori evaluation probe v1.0",
  "description": "Use hidden oracle criteria, not exact reference assistant text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "probe_id",
    "case_id",
    "probe_kind",
    "student_action",
    "history",
    "user_message",
    "oracle"
  ],
  "properties": {
    "probe_id": {
      "type": "string",
      "pattern": "^C[0-9]{3}-P0[1-3]$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^C[0-9]{3}$"
    },
    "probe_kind": {
      "type": "string",
      "enum": [
        "stage_choice",
        "role_resilience",
        "grounding",
        "resistance",
        "deescalation",
        "negotiation",
        "stage4",
        "impossible_limit"
      ]
    },
    "student_action": {
      "type": "string",
      "enum": [
        "competent",
        "mistake",
        "unexpected"
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "assistant",
              "user"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "user_message": {
      "type": "string",
      "minLength": 1
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must",
        "must_not",
        "rationale"
      ],
      "properties": {
        "must": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_not": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "allowed_variations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
