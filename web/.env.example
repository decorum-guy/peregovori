OPENROUTER_API_KEY=
# Optional HTTP Basic gate for HTTPS tunnel: username 'demo'; leave empty for localhost.
DEMO_ACCESS_CODE=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROXY_URL=
PREMIUM_MODEL=anthropic/claude-opus-5.5
# Cloud dialogue only. Total output includes reasoning and spoken text.
CLOUD_ROLEPLAYER_MAX_TOKENS=1200
# Opus 5.5: low/medium/high; default omits reasoning config. No effect on other models.
CLOUD_ROLEPLAYER_REASONING_EFFORT=low
CASE_MODEL=anthropic/claude-opus-5.5
JUDGE_MODEL=anthropic/claude-opus-5.5
# Independent completion detector, never Judge/Luna. Empty inherits PREMIUM_MODEL.
# Up to 4 checks/session at turns 3, 6, 9, 12; errors consume the budget too.
COMPLETION_ENABLED=true
COMPLETION_MODEL=
COMPLETION_MIN_TURNS=3
COMPLETION_COOLDOWN_TURNS=3
COMPLETION_MAX_CHECKS=4
COMPLETION_MAX_INPUT_CHARS=24000
COMPLETION_MAX_TOKENS=800
COMPLETION_TIMEOUT_SECONDS=8
LLM_MODE=openrouter
LORA_BASE_URL=http://127.0.0.1:18080
LORA_API_KEY=
LORA_MODEL=qwen3-custom
DATABASE_PATH=data/sessions.sqlite3
LLM_TIMEOUT_SECONDS=50
MAX_TURN_CHARS=4000
